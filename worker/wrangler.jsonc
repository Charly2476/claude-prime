// Réglages du Worker de l'API des outils (claude-prime).
// Aucun secret ici.
//
// À régler dans le tableau de bord (Workers & Pages > claude-prime-api > Settings > Variables and Secrets),
// gardés à chaque déploiement grâce à "keep_vars" :
//   ACCESS_TEAM_DOMAIN    variable  ex. "mon-equipe.cloudflareaccess.com"
//   ACCESS_AUD            variable  « Application Audience (AUD) Tag » de l'application Access
//   TURNSTILE_SITE_KEY    variable  clé publique du widget Turnstile (facultatif)
//   TURNSTILE_SECRET_KEY  SECRET    clé secrète Turnstile (facultatif, jamais dans le dépôt)
// Sans Access : toute modification est refusée. Turnstile s'ajoute à Access, il ne le remplace pas.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "claude-prime-api",
  "main": "index.js",
  "compatibility_date": "2026-07-01",

  // Pas d'adresse publique *.workers.dev : le Worker n'est joint que par le site
  // Cloudflare Pages, via la liaison de service API (functions/api/[[path]].js).
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,

  // DATA = le câble entre le Worker et le bucket R2.
  "r2_buckets": [
    { "binding": "DATA", "bucket_name": "formation-s4-donnees-mon-groupe" }
  ],

  "vars": {
    "ALLOWED_ORIGIN": "https://claude-prime-c6r.pages.dev",
    "TURNSTILE_HOSTNAME": "claude-prime-c6r.pages.dev",
    "TURNSTILE_ACTION": "soumission"
  }
}
